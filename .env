CONFIG_SERVICE_PASSWORD=
NOTIFICATION_SERVICE_PASSWORD=
STATISTICS_SERVICE_PASSWORD=
ACCOUNT_SERVICE_PASSWORD=

APPCONFIG_DOCUMENTDB_USERNAME_KEY=/shopping-cart/documentdb/username
APPCONFIG_DOCUMENTDB_PASSWORD_KEY=/shopping-cart/documentdb/password
APPCONFIG_DOCUMENTDB_HOST_KEY=/shopping-cart/documentdb/host
APPCONFIG_DOCUMENTDB_PORT_KEY=/shopping-cart/documentdb/port

DOCUMENTDB_TLS=true
DOCUMENTDB_CONNECTION_URI_TEMPLATE=mongodb://{username}:{password}@{host}:{port}/?tls=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false