{
  "family": "monitoring-dashboard",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/monitoringDashboardTaskRole",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "monitoring-dashboard",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/monitoring-dashboard:${IMAGE_TAG}",
      "essential": true,
      "portMappings": [
        {
          "name": "http-dashboard",
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "${AWS_REGION}"
        },
        {
          "name": "SERVICE_NAME",
          "value": "monitoring-dashboard"
        },
        {
          "name": "CLOUD_MAP_NAMESPACE",
          "value": "${CLOUD_MAP_NAMESPACE}"
        },
        {
          "name": "CLOUD_MAP_SERVICE_NAME",
          "value": "${CLOUD_MAP_SERVICE_NAME}"
        },
        {
          "name": "DOCDB_ENDPOINT",
          "value": "${DOCDB_ENDPOINT}"
        },
        {
          "name": "DOCDB_PORT",
          "value": "27017"
        },
        {
          "name": "DOCDB_DATABASE",
          "value": "${DOCDB_DATABASE}"
        },
        {
          "name": "DOCDB_USERNAME",
          "value": "${DOCDB_USERNAME}"
        },
        {
          "name": "RABBITMQ_ENDPOINT",
          "value": "${RABBITMQ_ENDPOINT}"
        },
        {
          "name": "RABBITMQ_PORT",
          "value": "5671"
        },
        {
          "name": "RABBITMQ_USERNAME",
          "value": "${RABBITMQ_USERNAME}"
        },
        {
          "name": "SES_FROM_EMAIL",
          "value": "${SES_FROM_EMAIL}"
        },
        {
          "name": "SES_REGION",
          "value": "${AWS_REGION}"
        }
      ],
      "secrets": [
        {
          "name": "DOCDB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:monitoring/docdb"
        },
        {
          "name": "RABBITMQ_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:monitoring/rabbitmq"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/monitoring-dashboard",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:3000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ],
  "volumes": [],
  "tags": [
    {
      "key": "Service",
      "value": "monitoring-dashboard"
    },
    {
      "key": "Environment",
      "value": "${ENVIRONMENT}"
    },
    {
      "key": "ManagedBy",
      "value": "ecs-fargate"
    }
  ]
}